type Query {
  hello: String
  getModel: Model
  getModels: [Model]
  getChildModels: [ChildModel]
  getChildModelsByModel(parent: String): [ChildModel]
}

type Mutation {
  createModel(modelInput: ModelInput): Model
}

input ModelInput {
  data: String
}

type Model {
  id: ID
  data: String
}

type ChildModel {
  id: ID
  data: String
  model: Model
}